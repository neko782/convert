@@ -0,0 +1,40 @@
+// The browser API consumed by src/handlers/turbowarp.ts.
+export interface Project {
+  type: string;
+  analysis: object;
+  [key: string]: unknown;
+}
+
+export function downloadProject(data: Uint8Array): Promise<Project>;
+
+export const loadProject: {
+  fromFile(
+    file: Blob,
+    progressCallback: (...args: unknown[]) => void,
+  ): Promise<{
+    promise: Promise<Project>;
+    terminate(): void;
+  }>;
+};
+
+export const largeAssets: Record<
+  string,
+  {
+    src: string | string[];
+    sha256?: string;
+    estimatedSize?: number;
+    useBuildId?: boolean;
+  }
+>;
+
+export class Packager {
+  project: Project;
+  options: { target: string; [key: string]: unknown };
+  package(): Promise<{
+    data: Uint8Array;
+    type: string;
+    filename: string;
+  }>;
+}
+
+export default Packager;
