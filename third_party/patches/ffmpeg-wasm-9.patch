+/* Stream side data moved to AVCodecParameters in FFmpeg 7. */
+static inline uint8_t *wasm_stream_new_side_data(AVStream *st,
+                                               enum AVPacketSideDataType type,
+                                               size_t size)
+{
+    AVPacketSideData *sd = av_packet_side_data_new(&st->codecpar->coded_side_data,
+        &st->codecpar->nb_coded_side_data, type, size, 0);
+    return sd ? sd->data : NULL;
+}
+
+static inline uint8_t *wasm_stream_get_side_data(const AVStream *st,
+                                               enum AVPacketSideDataType type,
+                                               size_t *size)
+{
+    const AVPacketSideData *sd = av_packet_side_data_get(st->codecpar->coded_side_data,
+        st->codecpar->nb_coded_side_data, type);
+    if (size) *size = sd ? sd->size : 0;
+    return sd ? sd->data : NULL;
+}
+
+/* Codec capability lists are queried through avcodec_get_supported_config. */
+static inline const enum AVPixelFormat *wasm_pix_fmts(const AVCodec *codec)
+{
+    const void *configs = NULL;
+    if (avcodec_get_supported_config(NULL, codec, AV_CODEC_CONFIG_PIX_FORMAT, 0,
+                                    &configs, NULL) < 0)
+        return NULL;
+    return configs;
+}
+
+static inline const enum AVSampleFormat *wasm_sample_fmts(const AVCodec *codec)
+{
+    const void *configs = NULL;
+    if (avcodec_get_supported_config(NULL, codec, AV_CODEC_CONFIG_SAMPLE_FORMAT, 0,
+                                    &configs, NULL) < 0)
+        return NULL;
+    return configs;
+}
+
+static inline const int *wasm_supported_samplerates(const AVCodec *codec)
+{
+    const void *configs = NULL;
+    if (avcodec_get_supported_config(NULL, codec, AV_CODEC_CONFIG_SAMPLE_RATE, 0,
+                                    &configs, NULL) < 0)
+        return NULL;
+    return configs;
+}
+
+static inline const AVRational *wasm_supported_framerates(const AVCodec *codec)
+{
+    const void *configs = NULL;
+    if (avcodec_get_supported_config(NULL, codec, AV_CODEC_CONFIG_FRAME_RATE, 0,
+                                    &configs, NULL) < 0)
+        return NULL;
+    return configs;
+}
+
+static inline const AVChannelLayout *wasm_ch_layouts(const AVCodec *codec)
+{
+    const void *configs = NULL;
+    if (avcodec_get_supported_config(NULL, codec, AV_CODEC_CONFIG_CHANNEL_LAYOUT, 0,
+                                    &configs, NULL) < 0)
+        return NULL;
+    return configs;
+}
+
