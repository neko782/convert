{
  "name": "p2r3-convert",
  "productName": "Convert to it!",
  "author": "PortalRunner",
  "description": "Truly universal browser-based file converter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/electron.cjs",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vendor": "bun tools/vendor.js",
    "prebuilt": "bun tools/prebuilt.js",
    "artifacts:check": "bun tools/check-artifacts.js",
    "dev": "bun run vendor && vite",
    "typecheck": "bun run vendor && tsc",
    "build": "bun run typecheck && vite build",
    "cache:build": "bun buildCache.js dist dist/cache.json --minify",
    "preview": "vite preview",
    "test": "bun run build && bun test ./test",
    "docker": "bun run docker:build && bun run docker:up",
    "docker:build": "docker compose --progress plain -f docker/docker-compose.yml -f docker/docker-compose.override.yml build",
    "docker:up": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.override.yml up -d",
    "desktop:build": "bun run build && bun run cache:build",
    "desktop:preview": "electron .",
    "desktop:start": "bun run desktop:build && bun run desktop:preview",
    "desktop:dist:win": "bun run desktop:build && electron-builder --win --publish never",
    "desktop:dist:mac": "bun run desktop:build && electron-builder --mac --publish never",
    "desktop:dist:linux": "bun run desktop:build && electron-builder --linux --publish never"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,css,scss,json,jsonc,md,html,yml,yaml}": "prettier --write"
  },
  "build": {
    "appId": "com.p2r3.convert",
    "artifactName": "convert-${version}-${arch}.${ext}",
    "executableName": "ConvertToIt",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/electron.cjs",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/less": "^3.0.8",
    "@types/opentype.js": "^1.3.10",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "puppeteer": "^25.10.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@flo-audio/reflo": "^0.1.2",
    "@imagemagick/magick-wasm": "^0.0.43",
    "@myriaddreamin/typst-ts-renderer": "^0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "@preact/signals": "^2.11.2",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@stringsync/vexml": "^1.3.0",
    "@toon-format/toon": "^4.1.1",
    "@turbowarp/jszip": "^3.12.0",
    "@types/bun": "^1.4.1",
    "@types/pako": "^3.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/three": "^0.185.4",
    "bson": "^7.3.2",
    "celaria-formats": "^1.0.2",
    "chess.js": "^1.4.0",
    "confbox": "^0.3.1",
    "imagetracer": "^0.2.2",
    "js-synthesizer": "^1.13.0",
    "jszip": "^3.10.1",
    "less": "^4.9.1",
    "lucide-preact": "^1.41.0",
    "meyda": "^5.6.3",
    "mime": "^4.1.0",
    "nanotar": "^0.3.0",
    "nbtify": "^2.2.0",
    "opentype.js": "^2.0.0",
    "pako": "^3.0.1",
    "papaparse": "^5.7.0",
    "pdf-parse": "^2.4.5",
    "pdftoimg-js": "^0.2.5",
    "pe-library": "^2.0.1",
    "preact": "^10.29.8",
    "sass": "^1.104.0",
    "svg-pathdata": "^9.0.0",
    "three": "^0.185.1",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.14",
    "tippy.js": "^6.3.7",
    "ts-flp": "^1.0.6",
    "use-debounce": "^10.1.1",
    "vexflow": "^5.0.0",
    "vite-plugin-static-copy": "^4.1.1",
    "wabt": "^1.0.39",
    "wavefile": "^11.0.0",
    "woff2-encoder": "^2.0.0",
    "yaml": "^2.9.0"
  }
}
